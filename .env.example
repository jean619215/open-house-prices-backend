# 注意：Docker postgres 對外為 5434（避開本機 postgres 與其他容器），見 README
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5434/realestate
# 注意：Docker redis 對外為 6380（避開其他容器佔用的 6379），見 README
REDIS_URL=redis://localhost:6380
SECRET_KEY=your-secret-key-here
ENVIRONMENT=development

# Optional — controls SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
